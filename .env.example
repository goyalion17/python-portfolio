# Copy this file to .env and fill in the values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your.address@gmail.com
# For Gmail: an app password (Google Account -> Security -> App passwords), not your normal password
MAIL_PASSWORD=
# Where messages should arrive (defaults to MAIL_USER)
MAIL_TO=
